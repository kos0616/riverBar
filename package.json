{
  "name": "river_bar",
  "version": "1.6.23",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite serve src/CUSTOMER --host",
    "build": "vite build src/CUSTOMER --emptyOutDir --mode example",
    "deploy": "vite build --mode offical src/CUSTOMER --emptyOutDir",
    "cf:deploy": "npm run build && npx wrangler pages deploy dist",
    "#dev": "vite --host",
    "#build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "1.16.6",
    "@microsoft/signalr": "^8.0.0",
    "@types/google.maps": "3.55.9",
    "axios": "^1.6.2",
    "axios-retry": "^4.4.2",
    "chart.js": "^4.4.2",
    "element-plus": "^2.6.1",
    "google": "2.1.0",
    "js-md5": "^0.8.3",
    "mitt": "^3.0.1",
    "pinia": "^2.1.6",
    "vue": "^3.3.4",
    "vue-chartjs": "^5.3.0",
    "vue-i18n": "^9.6.5",
    "vue-roller": "^2.1.0",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^18.17.17",
    "@vitejs/plugin-vue": "^4.3.4",
    "@vitejs/plugin-vue-jsx": "^3.0.2",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.4.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "npm-run-all2": "^6.0.6",
    "postcss": "^8.4.31",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "sass": "^1.69.3",
    "tailwindcss": "^3.3.3",
    "typescript": "~5.2.0",
    "vite": "^4.4.9",
    "vue-tsc": "^2.0.29"
  }
}
